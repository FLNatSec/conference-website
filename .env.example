# Copy to .env.local for local testing. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Kit (kit.com) — mailing list backend
KIT_API_KEY=          # Kit v4 API key (Settings → Developer → API keys)
KIT_FORM_ID=          # Numeric ID of the Kit form signups are added to
KIT_TAG_ID=           # Optional: numeric ID of the "website-signup" tag
KIT_ORG_FIELD_KEY=    # Optional: custom field key for organization (default: organization)
